*.key
id_ed25519*
triaconta_key*
secrets/
config_privada.json

# --- FILTRO DE PUREZA ADT AL 100% ---
# Bloqueo de cachés de ejecución
__pycache__/
*.py[cod]
*$py.class

# Bloqueo de archivos temporales de editores (Nano, Vim, etc.)
*.swp
*.swo
*~
.*.save

# Bloqueo de logs y basura del SO
*.log
.DS_Store
Thumbs.db
# --- PROTECCIÓN CRIPTOGRÁFICA Y BINARIA AL 100% ---
